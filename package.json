{
  "name": "gondi",
  "version": "0.30.3",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/src/index.d.ts",
  "files": [
    "dist"
  ],
  "workspaces": [
    ".",
    "examples"
  ],
  "scripts": {
    "docs": "typedoc --options ./typedocconfig.cts --out docs/$npm_package_version && rm -rf docs/lts && cp -r docs/$npm_package_version/ docs/lts/",
    "analyze": "METAFILE=true yarn build",
    "build": "node esbuild.js && tsc && tsc-alias",
    "build-unbundle": "tsc --outDir dist && tsc-alias",
    "verify": "bun run lint && bun run fmt-check",
    "lint": "yarn run fmt-check && eslint src/ --ext .js,.jsx,.ts,.tsx",
    "lint-fix": "yarn run fmt && eslint src/ --ext .js,.jsx,.ts,.tsx --fix",
    "fmt-check": "prettier --config .prettierrc --ignore-path .prettierignore --check .",
    "fmt": "prettier --config .prettierrc --ignore-path .prettierignore --write .",
    "test": "bun test",
    "gql:types": "tsx --env-file=.env codegen.ts",
    "prepare": "husky install",
    "postinstall": "husky install",
    "prepack": "pinst --disable",
    "postpack": "pinst --enable"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gondixyz/gondi-js.git"
  },
  "homepage": "https://gondixyz.github.io/gondi-js",
  "devDependencies": {
    "@graphql-codegen/add": "^5.0.0",
    "@graphql-codegen/cli": "^3.3.1",
    "@graphql-codegen/schema-ast": "^4.0.2",
    "@graphql-codegen/typescript": "^3.0.4",
    "@graphql-codegen/typescript-apollo-client-helpers": "^2.2.6",
    "@graphql-codegen/typescript-generic-sdk": "^3.1.0",
    "@graphql-codegen/typescript-operations": "^3.0.4",
    "@types/bun": "^1.3.12",
    "@types/node": "^20.4.6",
    "@typescript-eslint/eslint-plugin": "^5.49.0",
    "@typescript-eslint/parser": "^5.49.0",
    "esbuild": "0.25.12",
    "eslint": "^8.34.0",
    "eslint-config-prettier": "^8.6.0",
    "eslint-import-resolver-typescript": "^3.5.3",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-simple-import-sort": "^8.0.0",
    "graphql-codegen": "^0.4.0",
    "husky": "^8.0.3",
    "jest": "^29.6.2",
    "pinst": "^3.0.0",
    "prettier": "3.2.0",
    "siwe": "^2.1.4",
    "ts-jest": "^29.0.0",
    "tsc-alias": "^1.8.7",
    "tsconfig-paths": "^4.2.0",
    "tslib": "^2.4.0",
    "tsx": "^3.12.7",
    "typedoc": "^0.24.8",
    "typedoc-plugin-missing-exports": "^2.0.1",
    "typescript": "^5.0.4"
  },
  "dependencies": {
    "@apollo/client": "~3.9.10",
    "abitype": "^1.0.0",
    "apollo-link-scalars": "^4.0.2",
    "graphql": "^16.8.1",
    "graphql-tag": "^2.12.6",
    "viem": "^2.28.2"
  },
  "peerDependencies": {
    "@apollo/client": "~3.9.10",
    "viem": "^2.28.2"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "ajv": "6.14.0",
    "brace-expansion": "5.0.8",
    "esbuild": "0.25.12",
    "flatted": "3.4.2",
    "handlebars": "4.7.9",
    "immutable": "5.1.9",
    "js-yaml": "4.3.0",
    "lodash": "4.18.0",
    "minimatch": "10.2.5",
    "node-fetch": "2.7.0",
    "picomatch": "4.0.4",
    "shell-quote": "1.10.0",
    "ws": "8.21.1",
    "yaml": "1.10.3",
    "yargs-parser": "5.0.1"
  },
  "packageManager": "bun@1.3.14"
}
